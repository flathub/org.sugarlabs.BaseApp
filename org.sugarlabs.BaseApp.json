{
    "id": "org.sugarlabs.BaseApp",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "separate-locales": false,
    "build-options": {
        "env": {
            "PERL5LIB": "/app/lib/perl5/site_perl/5.42/"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "/share/aclocal",
        "/share/info",
        "/share/gtk-doc",
        "/share/man",
        "/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        "shared-modules/dbus-glib/dbus-glib.json",
        "shared-modules/intltool/intltool-0.51.json",
        {
            "name": "python3-empy",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"empy\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/3b/95/88ed47cb7da88569a78b7d6fb9420298df7e99997810c844a924d96d3c08/empy-3.3.4.tar.gz",
                    "sha256": "73ac49785b601479df4ea18a7c79bc1304a8a7c34c02b9472cf1206ae88f01b3",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "empy",
                        "versions": {
                            "<": "4.0"
                        }
                    }
                }
            ],
            "cleanup": [
                "*"
            ],
            "post-install": [
                "chmod +x /app/lib/python3.13/site-packages/em.py",
                "mkdir -p /app/bin/",
                "ln -s /app/lib/python3.13/site-packages/em.py /app/bin/empy"
            ]
        },
        {
            "name": "perl-XML-Simple",
            "cleanup": [
                "*"
            ],
            "buildsystem": "simple",
            "build-commands": [
                "perl Makefile.PL PREFIX=${FLATPAK_DEST}",
                "make install"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://cpan.metacpan.org/authors/id/G/GR/GRANTM/XML-Simple-2.25.tar.gz",
                    "sha256": "531fddaebea2416743eb5c4fdfab028f502123d9a220405a4100e68fc480dbf8",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 3537,
                        "stable-only": true,
                        "url-template": "https://cpan.metacpan.org/authors/id/G/GR/GRANTM/XML-Simple-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "xcursorgen",
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gitlab.freedesktop.org/xorg/app/xcursorgen/-/archive/xcursorgen-1.0.9/xcursorgen-xcursorgen-1.0.9.tar.gz",
                    "sha256": "9560a00238c6edd8b857547b275d83c762ad6f398362f93668ee9bdbfb542659",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 21210,
                        "stable-only": true,
                        "url-template": "https://gitlab.freedesktop.org/xorg/app/xcursorgen/-/archive/xcursorgen-$version/xcursorgen-xcursorgen-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "icon-naming-utils",
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "http://tango.freedesktop.org/releases/icon-naming-utils-0.8.90.tar.gz",
                    "sha256": "044ab2199ed8c6a55ce36fd4fcd8b8021a5e21f5bab028c0a7cdcf52a5902e1c",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1359,
                        "stable-only": true,
                        "url-template": "http://tango.freedesktop.org/releases/icon-naming-utils-$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "sugar-artwork",
            "no-parallel-make": true,
            "config-opts": [
                "--without-gtk2"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.sugarlabs.org/sources/sucrose/glucose/sugar-artwork/sugar-artwork-0.121.tar.xz",
                    "sha256": "d28a9b17ec54eab29f39e3dbd490956e9a588357209d523b1978c3df40d7bee2",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://download.sugarlabs.org/sources/sucrose/glucose/sugar-artwork/",
                        "pattern": "<a href=\"sugar-artwork-.+.tar.xz\">(sugar-artwork-(\\d+.\\d+.\\d+).tar.xz)</a>",
                        "url-pattern": "https://download.sugarlabs.org/sources/sucrose/glucose/sugar-artwork/sugar-artwork-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "python-dbus",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.pythonhosted.org/packages/ff/24/63118050c7dd7be04b1ccd60eab53fef00abe844442e1b6dec92dae505d6/dbus-python-1.4.0.tar.gz",
                    "sha256": "991666e498f60dbf3e49b8b7678f5559b8a65034fdf61aae62cdecdb7d89c770",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "dbus-python"
                    }
                }
            ]
        },
        {
            "name": "python3-decorator",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"decorator\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/43/fa/6d96a0978d19e17b68d634497769987b16c8f4cd0a7a05048bec693caa6b/decorator-5.2.1.tar.gz",
                    "sha256": "65f266143752f734b0a7cc83c46f4618af75b8c5911b00ccb61d0ac9b6da0360",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "decorator"
                    }
                }
            ]
        },
        {
            "name": "telepathy-glib",
            "config-opts": [
                "--disable-static",
                "--disable-gtk-doc"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/TelepathyIM/telepathy-glib.git",
                    "tag": "telepathy-glib-0.24.2",
                    "commit": "424e12a3277d23bc8cb3e84a1659a0939ade819e",
                    "x-checker-data": {
                        "type": "git",
                        "versions": {
                            "<": "0.99"
                        },
                        "tag-pattern": "^telepathy-glib-([\\d.]+)$"
                    }
                },
                {
		    "type": "patch",
		    "path": "telepathy-glib-prXXX-function-type-cast.patch"
                }
            ]
        },
        {
            "name": "sugar-toolkit-gtk3",
            "no-parallel-make": true,
            "config-opts": [
                "--with-python3"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.sugarlabs.org/sources/sucrose/glucose/sugar-toolkit-gtk3/sugar-toolkit-gtk3-0.121.tar.xz",
                    "sha256": "2b508b28d75fe30967de0650dcc67aaacfa579e707b043a2e43785c315039c57",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://download.sugarlabs.org/sources/sucrose/glucose/sugar-toolkit-gtk3/",
                        "pattern": "<a href=\"sugar-toolkit-gtk3-.+.tar.xz\">(sugar-toolkit-gtk3-(\\d+.\\d+.\\d+).tar.xz)</a>",
                        "url-pattern": "https://download.sugarlabs.org/sources/sucrose/glucose/sugar-toolkit-gtk3/sugar-toolkit-gtk3-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "sugarapp",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --find-links ${PWD} --prefix=${FLATPAK_DEST} $PWD --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/tchx84/sugarapp.git",
                    "tag": "v1.13",
                    "commit": "e05147e156e2cb13ac99985e8670463ffcfc09de",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ]
        }
    ]
}
